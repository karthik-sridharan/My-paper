\begin{tikzpicture}[>=stealth, every node/.style={font=\small}]\n  \tikzstyle{unit}=[circle, draw, thick, minimum size=8mm, align=center]\n  \node[font=\bfseries] at (0, 2.1) {Input};\n  \node[font=\bfseries] at (3, 2.1) {Hidden};\n  \node[font=\bfseries] at (6, 2.1) {Output};\n  \node[unit] (x1) at (0, 1.0) {$x_1$};\n  \node[unit] (x2) at (0,-1.0) {$x_2$};\n  \node[unit] (h1) at (3, 1.2) {$h_1$};\n  \node[unit] (h2) at (3, 0.0) {$h_2$};\n  \node[unit] (hm) at (3,-1.2) {$h_m$};\n  \node[unit] (y)  at (6, 0.0) {$y$};\n  \foreach \i in {x1,x2}{\n    \foreach \j in {h1,h2,hm}{\n      \draw[->, thick] (\i) -- (\j);\n    }\n  }\n  \foreach \j in {h1,h2,hm}{\n    \draw[->, thick] (\j) -- (y);\n  }\n  \node at (3,-2.05) {$h_j=\sigma(w_j^\top x+b_j)$};\n\end{tikzpicture}\n